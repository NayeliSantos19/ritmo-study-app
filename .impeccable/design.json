  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Primary Button: patrón de la interfaz implementada.",
      "html": "<button class=\"ds-primary\">Guardar sesión</button>",
      "css": ".ds-primary{background:var(--accent,#ba482c);color:#fff;border:0;border-radius:7px;padding:12px 20px;min-height:46px;font:600 16px/1.35 Source Sans,Segoe UI,sans-serif;cursor:pointer}.ds-primary:hover{background:var(--accent-hover,#9d3820)}.ds-primary:focus-visible{outline:3px solid #336e9d;outline-offset:4px}"
    },
    {
      "name": "Display Button",
      "kind": "button",
      "refersTo": "button-display",
      "description": "Display Button: patrón de la interfaz implementada.",
      "html": "<button class=\"ds-display\">Planificar sesión</button>",
      "css": ".ds-display{background:#c45134;color:#fff;border:0;border-radius:7px;padding:12px 20px;min-height:54px;font:600 20px/1.35 Source Sans,Segoe UI,sans-serif;cursor:pointer}.ds-display:hover{background:#c45134}.ds-display:focus-visible{outline:3px solid #336e9d;outline-offset:4px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Secondary Button: patrón de la interfaz implementada.",
      "html": "<button class=\"ds-secondary\">Cancelar</button>",
      "css": ".ds-secondary{background:#eef2f6;color:var(--ink,#203b52);border:0;border-radius:7px;padding:12px 20px;min-height:46px;font:600 16px/1.35 Source Sans,Segoe UI,sans-serif;cursor:pointer}.ds-secondary:hover{background:#e0e7ef}.ds-secondary:focus-visible{outline:3px solid #336e9d;outline-offset:4px}"
    },
    {
      "name": "Text Button",
      "kind": "button",
      "refersTo": "button-text",
      "description": "Text Button: patrón de la interfaz implementada.",
      "html": "<button class=\"ds-text\">Registrar sesión</button>",
      "css": ".ds-text{border:0;background:none;color:#9d3f28;padding:8px;min-height:40px;text-decoration:underline;text-underline-offset:4px;font:16px Source Sans,Segoe UI,sans-serif;cursor:pointer}.ds-text:hover{text-decoration:underline}.ds-text:focus-visible{outline:3px solid #336e9d;outline-offset:4px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Text Field: patrón de la interfaz implementada.",
      "html": "<label class=\"ds-label\">Tema<input class=\"ds-input\" placeholder=\"¿Qué vas a estudiar?\"></label>",
      "css": ".ds-label{display:grid;gap:6px;color:var(--ink,#203b52);font:600 14px/1.5 Source Sans,Segoe UI,sans-serif}.ds-input{border:1px solid #b5c2ce;border-radius:6px;background:#fff;color:var(--ink,#203b52);padding:10px 12px;min-height:44px;font:400 16px/1.5 Source Sans,Segoe UI,sans-serif}.ds-input::placeholder{color:#617286;opacity:1}.ds-input:focus-visible{outline:3px solid #336e9d;outline-offset:4px}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "nav-active",
      "description": "Navigation: patrón de la interfaz implementada.",
      "html": "<nav class=\"ds-nav\"><a href=\"#semana\" aria-current=\"page\">Mi semana</a><a href=\"#materias\">Materias</a></nav>",
      "css": ".ds-nav{display:grid;gap:12px;font:16px/1.5 Source Sans,Segoe UI,sans-serif}.ds-nav a{color:var(--ink,#203b52);padding:13px 18px;border-radius:6px;text-decoration:none}.ds-nav a:hover{background:#e9edf2}.ds-nav a[aria-current]{background:#f3e9e5;color:#973c27;font-weight:600}.ds-nav a:focus-visible{outline:3px solid #336e9d;outline-offset:4px}"
    },
    {
      "name": "Duration Selector",
      "kind": "chip",
      "refersTo": "duration-selected",
      "description": "Duration Selector: patrón de la interfaz implementada.",
      "html": "<button class=\"ds-duration\" aria-pressed=\"true\">25 min</button>",
      "css": ".ds-duration{border:1px solid #ae5037;color:#943e27;background:#faf0eb;border-radius:5px;padding:5px 8px;min-height:30px;font:12px/1.5 Source Sans,Segoe UI,sans-serif;cursor:pointer}.ds-duration:hover{background:#faf0eb}.ds-duration:focus-visible{outline:3px solid #336e9d;outline-offset:4px}"
    },
    {
      "name": "Focus Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Focus Panel: patrón de la interfaz implementada.",
      "html": "<section class=\"ds-panel\"><h2>Tu enfoque</h2><div class=\"ds-next\">Próxima sesión</div></section>",
      "css": ".ds-panel{background:var(--surface,#fff);border:1px solid var(--line,#e3e9ef);border-radius:9px;padding:18px 16px;color:var(--ink,#203b52);font:16px/1.5 Source Sans,Segoe UI,sans-serif}.ds-panel h2{font-size:21px;line-height:1.3;margin:0 0 17px}.ds-next{background:#f0f5f1;padding:18px;border-radius:9px}"
    },
    {
      "name": "Session Tile",
      "kind": "custom",
      "refersTo": "event",
      "description": "Session Tile: patrón de la interfaz implementada.",
      "html": "<button class=\"ds-event\"><strong>Matemáticas</strong><small>25 min · Planificada</small></button>",
      "css": ".ds-event{position:relative;border:0;border-radius:4px;background:#e0ece2;color:#193e32;text-align:left;padding:5px 7px;font:12px/1.25 Source Sans,Segoe UI,sans-serif;min-height:46px;cursor:pointer;transition:box-shadow .18s cubic-bezier(.16,1,.3,1)}.ds-event:before{content:\"\";position:absolute;inset:4px auto 4px 0;width:2px;background:#58835e}.ds-event strong,.ds-event small{display:block}.ds-event small{font-size:11px;margin-top:3px}.ds-event:hover{box-shadow:0 4px 12px #203b5220}@media(prefers-reduced-motion:reduce){.ds-event{transition:none}}.ds-event:focus-visible{outline:3px solid #336e9d;outline-offset:4px}"
    }
  ],
  "narrative": {
    "northStar": "El horario académico personal",
    "overview": "Una superficie clara y precisa para planificar el estudio. El texto petrol organiza la lectura, la terracota señala acciones y los colores suaves identifican materias sin competir con sus nombres. La retícula, las líneas finas y la tipografía compacta hacen legible una herramienta de uso diario.\n\nLa identidad se apoya en herramientas nativas, iconos SVG de trazo y una interfaz en español. El horario aprobado informa el lenguaje visual; su composición específica pertenece a la ficha de superficie, no a todas las pantallas.",
    "keyCharacteristics": [
      "Superficies claras con bordes finos.",
      "Jerarquía compacta y datos legibles.",
      "Color de materia acompañado por texto.",
      "Movimiento breve con alternativa reducida."
    ],
    "rules": [
      {
        "name": "The Text With Color Rule",
        "body": "El color de materia o estado siempre acompaña una etiqueta comprensible.",
        "section": "colors"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Mantener los contenedores ordinarios planos; reservar la sombra a interacción y superposición.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do conservar el texto petrol y las superficies claras.",
      "Do acompañar colores de materia y estados con etiquetas legibles.",
      "Do conservar foco visible y respetar movimiento reducido.",
      "Do mantener el desplazamiento de calendarios y tablas dentro de sus contenedores."
    ],
    "donts": [
      "Don't reintroducir el orbe, los gradientes ni el mundo violeta anterior.",
      "Don't convertir texto ni controles en imágenes.",
      "Don't presentar datos ilustrativos como actividad personal."
    ]
  }
}
